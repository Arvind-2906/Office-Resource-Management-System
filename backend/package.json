{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Production-grade E-Commerce REST API with MERN architecture & Prometheus metrics",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "node ./node_modules/jest/bin/jest.js --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
